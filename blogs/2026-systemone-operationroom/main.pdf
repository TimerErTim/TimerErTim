<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?><x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="xmp-writer"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/"  xmlns:xmp="http://ns.adobe.com/xap/1.0/"  xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"  xmlns:xmpTPg="http://ns.adobe.com/xap/1.0/t/pg/"  xmlns:pdf="http://ns.adobe.com/pdf/1.3/" ><dc:title><rdf:Alt><rdf:li xml:lang="x-default">How local System-One models compare to TypeSafe&apos;s Jev when assisting in the Operating Room</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">Can a local 2B System-One model control virtual operating-room equipment quickly and accurately? I compare JevK5-2B on an RTX 2080 with TypeSafe&apos;s Jev. Hosting it locally is feasible, but this setup falls behind on accuracy and latency.</rdf:li></rdf:Alt></dc:description><pdf:Keywords>System One, Jev, JevK5, Medicine, Rust, Analysis</pdf:Keywords><dc:creator><rdf:Seq><rdf:li>Tim Peko (TimerErTim)</rdf:li></rdf:Seq></dc:creator><xmp:CreatorTool>Typst 0.15.1</xmp:CreatorTool><dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language><xmp:ModifyDate>2026-10-22T22:57:52+02:00</xmp:ModifyDate><xmp:CreateDate>2026-10-22T22:57:52+02:00</xmp:CreateDate><xmpTPg:NPages>1</xmpTPg:NPages><dc:format>application/pdf</dc:format><xmpMM:InstanceID>36HWV9voeMxTXoiyYSuw8A==</xmpMM:InstanceID><xmpMM:DocumentID>IVc+UnWHwDmieBpix1SwQA==</xmpMM:DocumentID><xmpMM:RenditionClass>proof</xmpMM:RenditionClass><pdf:PDFVersion>1.7</pdf:PDFVersion></rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end="r"?>
